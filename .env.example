# Vorlage für die .env der Desktop-App (Projekt-Root). Nur Platzhalter, keine echten Werte.
# Zum Benutzen als .env kopieren und die Werte eintragen. Die App liest nur die Datei ".env".
# Es gilt immer nur ein Satz: den anderen auskommentiert lassen. Die App liest .env nur beim Start.

# ---------------------------------------------------------------------------
# Variante 1: Lokale Emulatoren (Entwicklung, Testdaten)
# ---------------------------------------------------------------------------
# true = Auth- und Firestore-Emulator auf diesem Rechner (müssen laufen, siehe README).
FIREBASE_USE_EMULATOR=true
FIREBASE_PROJECT_ID=congregation-planer
# Der Emulator braucht keinen echten Key; der Wert muss nur vorhanden sein, sonst meldet die App
# "Firebase nicht konfiguriert" und die Anmeldung läuft nicht.
FIREBASE_WEB_API_KEY=lokal-emulator
# Optional, wenn die Emulatoren nicht auf den Standard-Ports laufen:
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
FIREBASE_AUTH_EMULATOR_PORT=9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---------------------------------------------------------------------------
# Variante 2: Online-Datenbank (echte Daten, z. B. für den Import)
# ---------------------------------------------------------------------------
# false = Online-Dienste für Anmeldung und Firestore; die Firestore-Rules gelten für das angemeldete Konto.
# Änderungen sind echt. Dafür Variante 1 oben auskommentieren und diese Zeilen aktivieren.
# FIREBASE_USE_EMULATOR=false
# FIREBASE_PROJECT_ID=congregation-planer
# Echter Web-API-Key (Firebase-Konsole: Projekteinstellungen > Allgemein > Web-API-Schlüssel)
# FIREBASE_WEB_API_KEY=AIza...hier-den-schluessel-eintragen

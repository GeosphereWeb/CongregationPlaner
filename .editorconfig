# EditorConfig for ktlint and IDE formatting
# See https://kotlinlang.org/docs/coding-conventions.html

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 4
indent_style = space

# Kotlin files
[*.{kt,kts}]
ktlint_code_style = intellij_idea
indent_size = 4
continuation_indent_size = 4
ij_kotlin_indent_size = 4
ij_kotlin_continuation_indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_use_package_imports = false

# Naming rules: Allow PascalCase for Composables
# Try different property formats for maximum compatibility with ktlint 1.3.0
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_function-naming_ignore_when_annotated_with = Composable
ktlint_property_naming_ignore_when_annotated_with = Composable
ktlint_standard_property-naming_ignore_when_annotated_with = Composable

ij_kotlin_line_separator = \n
ij_kotlin_allow_single_line_if = false
ij_kotlin_keep_indents_on_empty_lines = false
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^

# XML files
[*.xml]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Properties files
[*.properties]
indent_size = 2

# Exclude generated files from linting
[**/build/generated/**.kt]
ktlint_standard = disabled

# Markdown files
[*.md]
trim_trailing_whitespace = false
insert_final_newline = false

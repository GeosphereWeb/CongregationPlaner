rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: admins
// Document ID: Firebase Auth UID
// Fields: none required. The existence of the document marks a global
//   administrator. Documents are created manually (Firebase console / Admin SDK).
//
// Organization hierarchy (readable WITHOUT sign-in so that a user can pick the
// congregation on the login screen; only the documents of the hierarchy are
// public, not their other subcollections):
//   region/{regionId}
//     subregion/{subregionId}
//       branch/{branchId}
//         circuit/{circuitId}          - name: string, overseer_name: string
//           congregation/{congId}      - name: string, meeting times/weekdays
//
// Collection: region/.../congregation/{congId}/members
// Document ID: Firebase Auth UID of the member, or a random Firestore ID for
//   persons without an account (e.g. children) that an admin records.
// Fields:
//   - email: string | null (required, immutable) - copied from the auth token
//   - displayName: string | null (required, immutable, <= 200 chars)
//   - approved: bool (required) - set by the congregation admin
//   - role: string (required, 'CONGREGATION_ADMIN' | 'MEMBER')
//   - permissions: list<string> (required, values from ['DUMMY', 'PLAN_TALKS', 'VIEW_MEMBERS'])
//   - hasAccount: bool (optional, immutable, default true) - false for persons
//     without an account; they are never approved and have no role or permissions
// Profile fields (optional because older documents do not have them yet;
// maintained by admins only):
//   - lastName, firstName: string (<= 100 chars)
//   - category: string | null ('BROTHER' | 'SISTER' | 'CHILD')
//   - baptized: bool (default false; never true for 'CHILD')
//   - appointment: string ('NONE' | 'MINISTERIAL_SERVANT' | 'ELDER';
//     anything but 'NONE' only for baptized brothers)
//   - mobilePhone, landlinePhone: string (<= 30 chars, digits and + ( ) / - space)
//   - isSpeaker: bool (default false; marks talk speakers, only for category 'BROTHER')
//
// Collection: region/.../congregation/{congId}/talkSchedule
// Document ID: the date as yyyy-MM-dd (one day of the weekend meeting; the weekday
//   is deliberately not checked because the meeting day can move at short notice).
// Readable and writable only by planners of this congregation (global admin, approved
//   congregation admin, or approved member with permission 'PLAN_TALKS').
// Fields:
//   - time: string (required, 'HH:mm')
//   - talkCancelled: bool (required)
//   - weekEventId, weekEventName: string | null (<= 100 chars, both set or both null)
//   - talkNumber: int | null (>= 1), talkTitle: string | null (1..200 chars); both set or both null.
//     The title is a snapshot of the talk list so that old slots stay unchanged.
//   - speakerMemberId: string | null (member uid), speakerLastName: string | null (1..100 chars),
//     speakerFirstName: string | null (<= 100 chars); all three set or all three null (snapshot of the member).
//   - chairmanMemberId, chairmanLastName, chairmanFirstName: same shape as the speaker fields (the chairman).
//
// Collection: weekEvents (global, identical for all congregations)
// Document ID: free. Fields: name: string, cancelsTalk: bool.
//   Readable by every signed-in user; maintained outside the app (console / Admin SDK).
//
// Collection: talkCatalog (global talk list, identical for all congregations)
// Document ID: the talk number (digits). Fields: title: string, active: bool.
//   Readable by every signed-in user; maintained outside the app (console / Admin SDK).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Approved congregation admin of exactly this congregation.
    function isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isAuthenticated() &&
        exists(memberPath) &&
        get(memberPath).data.approved == true &&
        get(memberPath).data.role == 'CONGREGATION_ADMIN';
    }

    function isValidRole(role) {
      return role in ['CONGREGATION_ADMIN', 'MEMBER'];
    }

    function isValidPermissions(permissions) {
      return permissions is list &&
        permissions.size() <= 10 &&
        permissions.toSet().hasOnly(['DUMMY', 'PLAN_TALKS', 'VIEW_MEMBERS']);
    }

    // May read (never write) the members of exactly this congregation: admins, or approved members with the
    // separate permission 'VIEW_MEMBERS'. PLAN_TALKS alone does not grant it.
    function canViewMembers(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isGlobalAdmin() ||
        isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) ||
        (isAuthenticated() &&
          exists(memberPath) &&
          get(memberPath).data.approved == true &&
          'VIEW_MEMBERS' in get(memberPath).data.permissions);
    }

    // Planners of exactly this congregation: global admin, congregation admin or member with PLAN_TALKS.
    function canPlanTalks(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isGlobalAdmin() ||
        isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) ||
        (isAuthenticated() &&
          exists(memberPath) &&
          get(memberPath).data.approved == true &&
          'PLAN_TALKS' in get(memberPath).data.permissions);
    }

    function isValidTalkSlot(date, data) {
      let eventId = data.get('weekEventId', null);
      let eventName = data.get('weekEventName', null);
      let talkNumber = data.get('talkNumber', null);
      let talkTitle = data.get('talkTitle', null);
      let speakerId = data.get('speakerMemberId', null);
      let speakerLast = data.get('speakerLastName', null);
      let speakerFirst = data.get('speakerFirstName', null);
      let chairmanId = data.get('chairmanMemberId', null);
      let chairmanLast = data.get('chairmanLastName', null);
      let chairmanFirst = data.get('chairmanFirstName', null);
      return date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.keys().hasOnly(['time', 'talkCancelled', 'weekEventId', 'weekEventName', 'talkNumber', 'talkTitle',
          'speakerMemberId', 'speakerLastName', 'speakerFirstName',
          'chairmanMemberId', 'chairmanLastName', 'chairmanFirstName']) &&
        data.keys().hasAll(['time', 'talkCancelled']) &&
        data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.talkCancelled is bool &&
        isNullableString(eventId, 100) &&
        isNullableString(eventName, 100) &&
        ((eventId == null) == (eventName == null)) &&
        (talkNumber == null || (talkNumber is int && talkNumber >= 1)) &&
        (talkTitle == null || (talkTitle is string && talkTitle.size() >= 1 && talkTitle.size() <= 200)) &&
        ((talkNumber == null) == (talkTitle == null)) &&
        (speakerId == null || (speakerId is string && speakerId.size() >= 1 && speakerId.size() <= 128)) &&
        (speakerLast == null || (speakerLast is string && speakerLast.size() >= 1 && speakerLast.size() <= 100)) &&
        (speakerFirst == null || (speakerFirst is string && speakerFirst.size() <= 100)) &&
        ((speakerId == null) == (speakerLast == null)) &&
        ((speakerId == null) == (speakerFirst == null)) &&
        (chairmanId == null || (chairmanId is string && chairmanId.size() >= 1 && chairmanId.size() <= 128)) &&
        (chairmanLast == null || (chairmanLast is string && chairmanLast.size() >= 1 && chairmanLast.size() <= 100)) &&
        (chairmanFirst == null || (chairmanFirst is string && chairmanFirst.size() <= 100)) &&
        ((chairmanId == null) == (chairmanLast == null)) &&
        ((chairmanId == null) == (chairmanFirst == null));
    }

    function isNullableString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isValidPhone(value) {
      return isShortString(value, 30) && value.matches('^[0-9+ ()/-]*$');
    }

    function accessFields() {
      return ['approved', 'role', 'permissions'];
    }

    function profileFields() {
      return ['lastName', 'firstName', 'category', 'baptized', 'appointment', 'mobilePhone', 'landlinePhone', 'isSpeaker'];
    }

    // Missing profile fields fall back to the defaults of a freshly registered member.
    function isValidProfile(data) {
      let category = data.get('category', null);
      let baptized = data.get('baptized', false);
      let appointment = data.get('appointment', 'NONE');
      return isShortString(data.get('lastName', ''), 100) &&
        isShortString(data.get('firstName', ''), 100) &&
        (category == null || category in ['BROTHER', 'SISTER', 'CHILD']) &&
        baptized is bool &&
        !(category == 'CHILD' && baptized) &&
        appointment in ['NONE', 'MINISTERIAL_SERVANT', 'ELDER'] &&
        (appointment == 'NONE' || (category == 'BROTHER' && baptized)) &&
        isValidPhone(data.get('mobilePhone', '')) &&
        isValidPhone(data.get('landlinePhone', '')) &&
        data.get('isSpeaker', false) is bool &&
        (data.get('isSpeaker', false) == false || category == 'BROTHER');
    }

    function hasDefaultProfile(data) {
      return data.get('lastName', '') == '' &&
        data.get('firstName', '') == '' &&
        data.get('category', null) == null &&
        data.get('baptized', false) == false &&
        data.get('appointment', 'NONE') == 'NONE' &&
        data.get('mobilePhone', '') == '' &&
        data.get('landlinePhone', '') == '' &&
        data.get('isSpeaker', false) == false;
    }

    // Persons without an account never get access to the app.
    function hasNoAccess(data) {
      return data.approved == false && data.role == 'MEMBER' && data.permissions.size() == 0;
    }

    // Validator for every member document after create or update.
    function isValidMember(data) {
      return data.keys().hasOnly(['email', 'displayName', 'approved', 'role', 'permissions', 'hasAccount']
          .concat(profileFields())) &&
        data.keys().hasAll(['email', 'displayName', 'approved', 'role', 'permissions']) &&
        isNullableString(data.email, 320) &&
        isNullableString(data.displayName, 200) &&
        data.approved is bool &&
        isValidRole(data.role) &&
        isValidPermissions(data.permissions) &&
        data.get('hasAccount', true) is bool &&
        (data.get('hasAccount', true) == true || hasNoAccess(data)) &&
        isValidProfile(data);
    }

    // A user may only register themselves: unapproved, plain member, default permission,
    // with the e-mail address from their auth token.
    function isValidSelfRegistration(uid) {
      let data = request.resource.data;
      return isAuthenticated() &&
        request.auth.uid == uid &&
        isValidMember(data) &&
        data.approved == false &&
        data.role == 'MEMBER' &&
        data.permissions == ['DUMMY'] &&
        data.email == request.auth.token.get('email', null) &&
        data.get('hasAccount', true) == true &&
        hasDefaultProfile(data);
    }

    // Admins record persons without an account (e.g. children) with a name.
    function isValidMemberWithoutAccount(regionId, subregionId, branchId, circuitId, congId) {
      let data = request.resource.data;
      return (isGlobalAdmin() || isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId)) &&
        isValidMember(data) &&
        data.get('hasAccount', true) == false &&
        data.email == null &&
        data.displayName == null &&
        data.get('lastName', '') != '' &&
        data.get('firstName', '') != '';
    }

    // E-mail, name and account type stay as registered.
    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ===============================================================
    // Global administrators
    // ===============================================================

    match /admins/{uid} {
      // Each user may check whether they are a global admin; nobody may write via the client.
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ===============================================================
    // Week events (global list)
    // ===============================================================

    match /weekEvents/{eventId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===============================================================
    // Talk list (global)
    // ===============================================================

    match /talkCatalog/{talkNumber} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ===============================================================
    // Organization hierarchy
    // ===============================================================

    match /region/{regionId} {
      allow read: if true;
      allow write: if isGlobalAdmin();

      match /subregion/{subregionId} {
        allow read: if true;
        allow write: if isGlobalAdmin();

        match /branch/{branchId} {
          allow read: if true;
          allow write: if isGlobalAdmin();

          match /circuit/{circuitId} {
            allow read: if true;
            allow write: if isGlobalAdmin();

            match /congregation/{congId} {
              allow read: if true;
              allow write: if isGlobalAdmin();

              // ---------------------------------------------------------
              // Members of a congregation
              // ---------------------------------------------------------
              match /members/{uid} {
                allow get: if isAuthenticated() && (
                  request.auth.uid == uid ||
                  canViewMembers(regionId, subregionId, branchId, circuitId, congId)
                );

                allow list: if canViewMembers(regionId, subregionId, branchId, circuitId, congId);

                allow create: if isValidSelfRegistration(uid) ||
                  isValidMemberWithoutAccount(regionId, subregionId, branchId, circuitId, congId);

                // Admins maintain profiles, including their own, but cannot change their own
                // access, so nobody locks themselves out.
                allow update: if isAuthenticated() &&
                  (isGlobalAdmin() || isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId)) &&
                  (onlyFieldsChanged(profileFields()) ||
                    (request.auth.uid != uid && onlyFieldsChanged(accessFields().concat(profileFields())))) &&
                  isValidMember(request.resource.data);

                allow delete: if isAuthenticated() && (
                  request.auth.uid == uid ||
                  isGlobalAdmin() ||
                  isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId)
                );
              }

              // ---------------------------------------------------------
              // Talk schedule of a congregation (planners only)
              // ---------------------------------------------------------
              match /talkSchedule/{date} {
                allow read, delete: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidTalkSlot(date, request.resource.data);
              }
            }
          }
        }
      }
    }
  }
}

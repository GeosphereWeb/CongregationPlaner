rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: admins
// Document ID: Firebase Auth UID
// Fields: none required. The existence of the document marks a global
//   administrator. Documents are created manually (Firebase console / Admin SDK).
//
// Organization hierarchy (readable WITHOUT sign-in so that a user can pick the
// congregation on the login screen; only the documents of the hierarchy are
// public, not their other subcollections):
//   region/{regionId}
//     subregion/{subregionId}
//       branch/{branchId}
//         circuit/{circuitId}          - name: string, overseer_name: string
//           congregation/{congId}      - name: string, meeting times/weekdays
//
// Collection: region/.../congregation/{congId}/members
// Document ID: Firebase Auth UID of the member, or a random Firestore ID for
//   persons without an account (e.g. children) that an admin records.
// Fields:
//   - email: string | null (required, immutable) - copied from the auth token
//   - displayName: string | null (required, immutable, <= 200 chars)
//   - approved: bool (required) - set by the congregation admin
//   - roles: list<string> (required, <= 10 distinct values from ['CONGREGATION_ADMIN', 'TALK_PLANNER',
//     'TASK_PLANNER']; empty for a plain member, see ADR-0012)
//   - hasAccount: bool (optional, immutable, default true) - false for persons
//     without an account; they are never approved and have no role
// Profile fields (optional because older documents do not have them yet;
// maintained by admins only):
//   - lastName, firstName: string (<= 100 chars)
//   - category: string | null ('BROTHER' | 'SISTER' | 'CHILD')
//   - baptized: bool (default false; never true for 'CHILD')
//   - appointment: string ('NONE' | 'MINISTERIAL_SERVANT' | 'ELDER';
//     anything but 'NONE' only for baptized brothers)
//   - mobilePhone, landlinePhone: string (<= 30 chars, digits and + ( ) / - space)
//   - isSpeaker: bool (default false; marks talk speakers, only for category 'BROTHER')
//
// Collection: region/.../congregation/{congId}/talkSchedule
// Document ID: the date as yyyy-MM-dd (one day of the weekend meeting; the weekday
//   is deliberately not checked because the meeting day can move at short notice).
// Readable and writable only by planners of this congregation (approved members with the role
//   'TALK_PLANNER'; the role 'CONGREGATION_ADMIN' alone is not enough, and global admins have no access, ADR-0013).
// Fields:
//   - time: string (required, 'HH:mm')
//   - talkCancelled: bool (required)
//   - weekEventId, weekEventName: string | null (<= 100 chars, both set or both null)
//   - talkNumber: int | null (>= 1), talkTitle: string | null (1..200 chars); both set or both null.
//     The title is a snapshot of the talk list so that old slots stay unchanged.
//   - speakerMemberId: string | null (member uid), speakerLastName: string | null (1..100 chars),
//     speakerFirstName: string | null (<= 100 chars); all three set or all three null (snapshot of the member).
//   - chairmanMemberId, chairmanLastName, chairmanFirstName: same shape as the speaker fields (the chairman).
//   - A member is never speaker and chairman on the same day (speakerMemberId != chairmanMemberId).
//   - externalSpeakerId: string | null, speakerCongregation: string | null (1..100 chars): an external speaker
//     instead of a member; then the speaker name fields are set and speakerMemberId is null (never both).
//
// Directory of external speakers, kept by the planners of this congregation. Independent of the organization
// hierarchy above: circuits and congregations are entered by the planner. Document IDs: free (auto id).
// Readable and writable only by planners of this congregation.
//   region/.../congregation/{congId}/externalCircuits:      name: string (1..100)
//   region/.../congregation/{congId}/externalCongregations: circuitId: string (id of an external circuit),
//     name: string (1..100)
//   region/.../congregation/{congId}/visitingSpeakers: congregationId: string (id of an external congregation),
//     lastName: string (1..100), firstName: string (<= 100), phone: string (<= 30), email: string (<= 200),
//     talkNumbers: list<int> (<= 200 entries, the talk numbers the speaker gives)
// The rules check the form only, not whether circuitId/congregationId exist; the app does that.
//
// Collection: weekEvents (global, identical for all congregations)
// Document ID: free. Fields: name: string (1..100), cancelsTalk: bool.
//   Readable by every signed-in user; written only by global admins (in the app or the console).
//
// Collection: talkCatalog (global talk list, identical for all congregations)
// Document ID: the talk number (1..9999, no leading zero). Fields: title: string (1..200), active: bool.
//   Readable by every signed-in user; written only by global admins (in the app or the console).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Approved congregation admin of exactly this congregation.
    function isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isAuthenticated() &&
        exists(memberPath) &&
        get(memberPath).data.approved == true &&
        hasRole(get(memberPath).data, 'CONGREGATION_ADMIN');
    }

    // The member document grants the role through its `roles` list (ADR-0012).
    function hasRole(data, wanted) {
      return wanted in data.get('roles', []);
    }

    function isValidRoles(roles) {
      return roles is list &&
        roles.size() <= 10 &&
        roles.toSet().size() == roles.size() &&
        roles.toSet().hasOnly(['CONGREGATION_ADMIN', 'TALK_PLANNER', 'TASK_PLANNER']);
    }

    // May read (never write) the members of exactly this congregation: admins and approved planners (talk or task).
    // Global admins have no access to the members (ADR-0013).
    function canViewMembers(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) ||
        (isAuthenticated() &&
          exists(memberPath) &&
          get(memberPath).data.approved == true &&
          (hasRole(get(memberPath).data, 'TALK_PLANNER') ||
            hasRole(get(memberPath).data, 'TASK_PLANNER')));
    }

    // Planners of exactly this congregation: approved members with the role TALK_PLANNER. The role CONGREGATION_ADMIN
    // alone does not grant it, and global admins have no access (ADR-0013).
    function canPlanTalks(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isAuthenticated() &&
        exists(memberPath) &&
        get(memberPath).data.approved == true &&
        hasRole(get(memberPath).data, 'TALK_PLANNER');
    }

    function isValidWeekEvent(data) {
      return data.keys().hasOnly(['name', 'cancelsTalk']) &&
        data.keys().hasAll(['name', 'cancelsTalk']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.cancelsTalk is bool;
    }

    function isValidCatalogTalk(data) {
      return data.keys().hasOnly(['title', 'active']) &&
        data.keys().hasAll(['title', 'active']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.active is bool;
    }

    // Directory of external speakers: circuit -> congregation -> speaker, kept by the planners (see header).
    function isValidExternalCircuit(data) {
      return data.keys().hasOnly(['name']) && data.keys().hasAll(['name']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100;
    }

    function isValidExternalCongregation(data) {
      return data.keys().hasOnly(['circuitId', 'name']) && data.keys().hasAll(['circuitId', 'name']) &&
        data.circuitId is string && data.circuitId.size() >= 1 && data.circuitId.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100;
    }

    // The elements of talkNumbers cannot be checked in the rules; the app validates them (ints 1..9999).
    function isValidVisitingSpeaker(data) {
      return data.keys().hasOnly(['congregationId', 'lastName', 'firstName', 'phone', 'email', 'talkNumbers']) &&
        data.keys().hasAll(['congregationId', 'lastName', 'firstName', 'phone', 'email', 'talkNumbers']) &&
        data.congregationId is string && data.congregationId.size() >= 1 && data.congregationId.size() <= 100 &&
        data.lastName is string && data.lastName.size() >= 1 && data.lastName.size() <= 100 &&
        data.firstName is string && data.firstName.size() <= 100 &&
        data.phone is string && data.phone.size() <= 30 &&
        data.email is string && data.email.size() <= 200 &&
        data.talkNumbers is list && data.talkNumbers.size() <= 200;
    }

    // Talk history: one document per talk number holding the days the talk was given (plannedOn: from the planning,
    // speakers: speaker name per day).
    function isValidTalkHistory(talkNumber, data) {
      return talkNumber.matches('[1-9][0-9]{0,3}') &&
        data.keys().hasOnly(['heldOn', 'plannedOn', 'speakers']) && data.keys().hasAll(['heldOn']) &&
        data.heldOn is list && data.heldOn.size() >= 1 && data.heldOn.size() <= 100 &&
        (!('plannedOn' in data) || (data.plannedOn is list && data.plannedOn.size() <= 100)) &&
        (!('speakers' in data) || (data.speakers is map && data.speakers.size() <= 100));
    }

    // A text that is either absent (null) or a string with minLen..maxLen characters.
    function isOptionalText(value, minLen, maxLen) {
      return value == null || (value is string && value.size() >= minLen && value.size() <= maxLen);
    }

    // Talk number and title are a snapshot of the talk list: both set or both null.
    function isValidTalkFields(data) {
      let talkNumber = data.get('talkNumber', null);
      let talkTitle = data.get('talkTitle', null);
      return (talkNumber == null || (talkNumber is int && talkNumber >= 1)) &&
        isOptionalText(talkTitle, 1, 200) &&
        ((talkNumber == null) == (talkTitle == null));
    }

    // The speaker is a member or an external speaker (never both); the name fields are set exactly then, and the
    // congregation snapshot belongs to external speakers only.
    function isValidSpeakerFields(data) {
      let memberId = data.get('speakerMemberId', null);
      let externalId = data.get('externalSpeakerId', null);
      let lastName = data.get('speakerLastName', null);
      let firstName = data.get('speakerFirstName', null);
      let congregation = data.get('speakerCongregation', null);
      let hasSpeaker = memberId != null || externalId != null;
      return isOptionalText(memberId, 1, 128) &&
        isOptionalText(externalId, 1, 128) &&
        isOptionalText(lastName, 1, 100) &&
        isOptionalText(firstName, 0, 100) &&
        isOptionalText(congregation, 1, 100) &&
        (memberId == null || externalId == null) &&
        ((externalId == null) == (congregation == null)) &&
        (hasSpeaker == (lastName != null)) &&
        (hasSpeaker == (firstName != null));
    }

    // The chairman is a member snapshot: id, last name and first name all set or all null.
    function isValidChairmanFields(data) {
      let memberId = data.get('chairmanMemberId', null);
      let lastName = data.get('chairmanLastName', null);
      let firstName = data.get('chairmanFirstName', null);
      return isOptionalText(memberId, 1, 128) &&
        isOptionalText(lastName, 1, 100) &&
        isOptionalText(firstName, 0, 100) &&
        ((memberId == null) == (lastName == null)) &&
        ((memberId == null) == (firstName == null));
    }

    function isValidTalkSlot(date, data) {
      let eventId = data.get('weekEventId', null);
      let eventName = data.get('weekEventName', null);
      return date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
        data.keys().hasOnly(['time', 'talkCancelled', 'weekEventId', 'weekEventName', 'talkNumber', 'talkTitle',
          'speakerMemberId', 'speakerLastName', 'speakerFirstName',
          'chairmanMemberId', 'chairmanLastName', 'chairmanFirstName', 'externalSpeakerId', 'speakerCongregation']) &&
        data.keys().hasAll(['time', 'talkCancelled']) &&
        data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.talkCancelled is bool &&
        isNullableString(eventId, 100) &&
        isNullableString(eventName, 100) &&
        ((eventId == null) == (eventName == null)) &&
        isValidTalkFields(data) &&
        isValidSpeakerFields(data) &&
        isValidChairmanFields(data) &&
        // A member is never speaker and chairman on the same day.
        (data.get('speakerMemberId', null) == null || data.get('chairmanMemberId', null) == null ||
          data.get('speakerMemberId', null) != data.get('chairmanMemberId', null));
    }

    // May read the admin contacts of exactly this congregation: global admins and everybody with a member
    // document there, approved or not, so that a new user can see whom to ask for approval.
    function canReadAdminContacts(regionId, subregionId, branchId, circuitId, congId) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(request.auth.uid);
      return isGlobalAdmin() || (isAuthenticated() && exists(memberPath));
    }

    // Admin contacts only carry the name; nothing else of the member is exposed.
    function isValidAdminContact(data) {
      return data.keys().hasOnly(['firstName', 'lastName']) &&
        data.keys().hasAll(['firstName', 'lastName']) &&
        isShortString(data.firstName, 100) &&
        isShortString(data.lastName, 100);
    }

    // The contact mirrors an approved congregation admin as the member document will look after this write.
    function mirrorsAdminMember(regionId, subregionId, branchId, circuitId, congId, uid, data) {
      let memberPath = /databases/$(database)/documents/region/$(regionId)/subregion/$(subregionId)/branch/$(branchId)/circuit/$(circuitId)/congregation/$(congId)/members/$(uid);
      return existsAfter(memberPath) &&
        getAfter(memberPath).data.approved == true &&
        hasRole(getAfter(memberPath).data, 'CONGREGATION_ADMIN') &&
        getAfter(memberPath).data.get('firstName', '') == data.firstName &&
        getAfter(memberPath).data.get('lastName', '') == data.lastName;
    }

    function isNullableString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isValidPhone(value) {
      return isShortString(value, 30) && value.matches('^[0-9+ ()/-]*$');
    }

    function roleFields() {
      return ['roles'];
    }

    function accessFields() {
      return ['approved'].concat(roleFields());
    }

    function profileFields() {
      return ['lastName', 'firstName', 'category', 'baptized', 'appointment', 'mobilePhone', 'landlinePhone', 'isSpeaker'];
    }

    // Missing profile fields fall back to the defaults of a freshly registered member.
    function isValidProfile(data) {
      let category = data.get('category', null);
      let baptized = data.get('baptized', false);
      let appointment = data.get('appointment', 'NONE');
      return isShortString(data.get('lastName', ''), 100) &&
        isShortString(data.get('firstName', ''), 100) &&
        (category == null || category in ['BROTHER', 'SISTER', 'CHILD']) &&
        baptized is bool &&
        !(category == 'CHILD' && baptized) &&
        appointment in ['NONE', 'MINISTERIAL_SERVANT', 'ELDER'] &&
        (appointment == 'NONE' || (category == 'BROTHER' && baptized)) &&
        isValidPhone(data.get('mobilePhone', '')) &&
        isValidPhone(data.get('landlinePhone', '')) &&
        data.get('isSpeaker', false) is bool &&
        (data.get('isSpeaker', false) == false || category == 'BROTHER');
    }

    function hasDefaultProfile(data) {
      return data.get('lastName', '') == '' &&
        data.get('firstName', '') == '' &&
        data.get('category', null) == null &&
        data.get('baptized', false) == false &&
        data.get('appointment', 'NONE') == 'NONE' &&
        data.get('mobilePhone', '') == '' &&
        data.get('landlinePhone', '') == '' &&
        data.get('isSpeaker', false) == false;
    }

    // Persons without an account never get access to the app.
    function hasNoAccess(data) {
      return data.approved == false && data.roles.size() == 0;
    }

    // Validator for every member document after create or update.
    function isValidMember(data) {
      return data.keys().hasOnly(['email', 'displayName', 'approved', 'hasAccount'].concat(roleFields())
          .concat(profileFields())) &&
        data.keys().hasAll(['email', 'displayName', 'approved', 'roles']) &&
        isNullableString(data.email, 320) &&
        isNullableString(data.displayName, 200) &&
        data.approved is bool &&
        isValidRoles(data.roles) &&
        data.get('hasAccount', true) is bool &&
        (data.get('hasAccount', true) == true || hasNoAccess(data)) &&
        isValidProfile(data);
    }

    // A user may only register themselves: unapproved, without roles,
    // with the e-mail address from their auth token.
    function isValidSelfRegistration(uid) {
      let data = request.resource.data;
      return isAuthenticated() &&
        request.auth.uid == uid &&
        isValidMember(data) &&
        data.approved == false &&
        data.roles.size() == 0 &&
        data.email == request.auth.token.get('email', null) &&
        data.get('hasAccount', true) == true &&
        hasDefaultProfile(data);
    }

    // Admins record persons without an account (e.g. children) with a name.
    function isValidMemberWithoutAccount(regionId, subregionId, branchId, circuitId, congId) {
      let data = request.resource.data;
      return isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) &&
        isValidMember(data) &&
        data.get('hasAccount', true) == false &&
        data.email == null &&
        data.displayName == null &&
        data.get('lastName', '') != '' &&
        data.get('firstName', '') != '';
    }

    // E-mail, name and account type stay as registered.
    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // An admin who changes the own member document keeps the admin role.
    function keepsOwnAdminRole() {
      return !hasRole(resource.data, 'CONGREGATION_ADMIN') ||
        ('roles' in request.resource.data && 'CONGREGATION_ADMIN' in request.resource.data.roles);
    }

    // ===============================================================
    // Global administrators
    // ===============================================================

    match /admins/{uid} {
      // Each user may check whether they are a global admin; nobody may write via the client.
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ===============================================================
    // Week events (global list)
    // ===============================================================

    match /weekEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create, update: if isGlobalAdmin() && isValidWeekEvent(request.resource.data);
      allow delete: if isGlobalAdmin();
    }

    // ===============================================================
    // Talk list (global)
    // ===============================================================

    match /talkCatalog/{talkNumber} {
      allow read: if isAuthenticated();
      allow create, update: if isGlobalAdmin() &&
        talkNumber.matches('^[1-9][0-9]{0,3}$') &&
        isValidCatalogTalk(request.resource.data);
      allow delete: if isGlobalAdmin();
    }

    // ===============================================================
    // Organization hierarchy
    // ===============================================================

    match /region/{regionId} {
      allow read: if true;
      allow write: if isGlobalAdmin();

      match /subregion/{subregionId} {
        allow read: if true;
        allow write: if isGlobalAdmin();

        match /branch/{branchId} {
          allow read: if true;
          allow write: if isGlobalAdmin();

          match /circuit/{circuitId} {
            allow read: if true;
            allow write: if isGlobalAdmin();

            match /congregation/{congId} {
              allow read: if true;
              allow create, delete: if isGlobalAdmin();
              // Global admins may change the name only; the congregation admin may also change the meeting times of
              // exactly this congregation (ADR-0013).
              allow update: if (isGlobalAdmin() &&
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) || (
                isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'name', 'midweek_meeting_time', 'midweek_meeting_weekday',
                  'weekend_meeting_time', 'weekend_meeting_weekday', 'yearly_meeting_times'])
              );

              // ---------------------------------------------------------
              // Members of a congregation
              // ---------------------------------------------------------
              match /members/{uid} {
                allow get: if isAuthenticated() && (
                  request.auth.uid == uid ||
                  canViewMembers(regionId, subregionId, branchId, circuitId, congId)
                );

                allow list: if canViewMembers(regionId, subregionId, branchId, circuitId, congId);

                allow create: if isValidSelfRegistration(uid) ||
                  isValidMemberWithoutAccount(regionId, subregionId, branchId, circuitId, congId);

                // Admins maintain profiles and roles of every member. In their own document they may change the
                // roles but neither the approval nor remove their own admin role,
                // so nobody locks themselves out. The approval of others is set here too.
                allow update: if isAuthenticated() &&
                  isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) &&
                  (request.auth.uid == uid
                    ? (onlyFieldsChanged(profileFields().concat(roleFields())) && keepsOwnAdminRole())
                    : onlyFieldsChanged(accessFields().concat(profileFields()))) &&
                  isValidMember(request.resource.data);

                allow delete: if isAuthenticated() && (
                  request.auth.uid == uid ||
                  isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId)
                );
              }

              // ---------------------------------------------------------
              // Admin contacts: first and last name of the approved admins of this congregation. Readable
              // before approval; maintained by admins together with the member document.
              // ---------------------------------------------------------
              match /adminContacts/{uid} {
                allow read: if canReadAdminContacts(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidAdminContact(request.resource.data) &&
                  mirrorsAdminMember(regionId, subregionId, branchId, circuitId, congId, uid, request.resource.data);

                // Admins maintain contacts; everybody may drop their own (e.g. after leaving the congregation).
                allow delete: if isCongregationAdmin(regionId, subregionId, branchId, circuitId, congId) ||
                  (isAuthenticated() && request.auth.uid == uid);
              }

              // ---------------------------------------------------------
              // Talk schedule of a congregation (planners only)
              // ---------------------------------------------------------
              match /talkSchedule/{date} {
                allow read, delete: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidTalkSlot(date, request.resource.data);
              }

              // ---------------------------------------------------------
              // Talk history of a congregation (planners only)
              // ---------------------------------------------------------
              match /talkHistory/{talkNumber} {
                allow read, delete: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidTalkHistory(talkNumber, request.resource.data);
              }

              // ---------------------------------------------------------
              // Directory of external speakers (planners only)
              // ---------------------------------------------------------
              match /externalCircuits/{externalCircuitId} {
                allow read, delete: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidExternalCircuit(request.resource.data);
              }

              match /externalCongregations/{externalCongregationId} {
                allow read, delete: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidExternalCongregation(request.resource.data);
              }

              match /visitingSpeakers/{speakerId} {
                allow read, delete: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId);

                allow create, update: if canPlanTalks(regionId, subregionId, branchId, circuitId, congId) &&
                  isValidVisitingSpeaker(request.resource.data);
              }
            }
          }
        }
      }
    }
  }
}

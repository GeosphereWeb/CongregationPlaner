name: CI Code Quality

on:
  push:
    branches: [ master, main ]
  pull_request:
    branches: [ master, main ]

jobs:
  build-and-analyze:
    name: Build, Lint & Coverage
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up JDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '21' # Upgrade auf 21 empfohlen

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      # Falls du CodeQL nutzen willst, hier initialisieren:
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: java-kotlin

      - name: Run ktlint
        run: ./gradlew ktlintCheck

      - name: Run detekt
        run: ./gradlew detekt

      # Dieser Schritt ersetzt den fehlerhaften "autobuild"
      - name: Build for CodeQL
        run: ./gradlew assembleDebug

      - name: Run Tests with Kover
        run: ./gradlew koverXmlReport

      - name: SonarCloud Scan
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
        run: ./gradlew sonar --info

      # Falls CodeQL aktiv ist, hier abschließen:
      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3